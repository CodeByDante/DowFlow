{
  "manifest_version": 3,
  "name": "Local Video Downloader",
  "version": "1.0",
  "description": "Descarga videos directamente a tu PC usando Native Messaging.",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "storage",
    "cookies",
    "webRequest",
    "scripting",
    "clipboardRead",
    "contextMenus"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon.png",
      "48": "icons/icon.png",
      "128": "icons/icon.png"
    }
  },
  "background": {
    "service_worker": "js/background.js"
  }
}
